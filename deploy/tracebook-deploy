#!/usr/bin/env bash
# Deploy entry point for CI, installed as /usr/local/bin/tracebook-deploy and bound to the deploy key:
#   ~tracebook-deploy/.ssh/authorized_keys: command="/usr/local/bin/tracebook-deploy",restrict ssh-ed25519 AAAA... tracebook-ci
# so that key can only run "deploy <40-hex commit>". A registry token may arrive on stdin.
#
# pull ghcr.io/winkless213/tracebook:<commit> -> online SQLite backup -> switch -> wait until /health
# reports <commit>; otherwise switch back to the previous release and exit non-zero.
set -euo pipefail

app_dir=/opt/tracebook
image=ghcr.io/winkless213/tracebook
health=http://127.0.0.1:8083/health

read -r action release extra <<<"${SSH_ORIGINAL_COMMAND:-$*}"
if [[ ${action:-} != deploy || ! ${release:-} =~ ^[0-9a-f]{40}$ || -n ${extra:-} ]]; then
  echo 'usage: deploy <40-hex commit>' >&2
  exit 2
fi

cd "$app_dir"
exec 9>deploy.lock
flock -n 9 || { echo 'another deploy is running' >&2; exit 75; }

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a releases.log >&2; }

switch_to() {
  APP_RELEASE=$1 docker compose up -d --no-build --wait --wait-timeout 180 app
}

reports() {
  for _ in $(seq 40); do
    curl -fsS --max-time 3 "$health" 2>/dev/null | grep -qF "\"release\":\"$1\"" && return 0
    sleep 3
  done
  return 1
}

if ! docker image inspect "$image:$release" >/dev/null 2>&1; then
  token=
  IFS= read -r -t 5 token || true
  [[ -z $token ]] || printf '%s' "$token" | docker login ghcr.io -u ci --password-stdin >/dev/null
  pulled=0
  docker pull -q "$image:$release" >/dev/null && pulled=1
  [[ -z $token ]] || docker logout ghcr.io >/dev/null
  if ((!pulled)); then
    log "pull failed: $release"
    exit 1
  fi
fi

previous=$(cat current-release 2>/dev/null || true)
if [[ -n $(docker compose ps --status running -q app) ]]; then
  backup=/data/backups/before-${release:0:12}-$(date -u +%Y%m%dT%H%M%SZ).sqlite
  docker compose exec -T app python scripts/backup.py /data/knowledge.sqlite "$backup" >/dev/null
  docker compose exec -T app sh -c 'ls -1t /data/backups/before-*.sqlite | tail -n +11 | xargs -r rm -f --'
  log "backup $backup"
fi

log "deploy $release (previous: ${previous:-none})"
if switch_to "$release" && reports "$release"; then
  echo "$release" >current-release
  log "live $release image $(docker image inspect -f '{{.Id}}' "$image:$release")"
  exit 0
fi

log "failed $release"
docker compose logs --tail 40 app >&2 || true
if [[ -n $previous ]] && switch_to "$previous" && reports "$previous"; then
  log "rolled back to $previous"
else
  log "rollback to ${previous:-none} failed"
fi
exit 1
