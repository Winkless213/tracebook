APP_PASSWORD=replace-with-a-random-password-at-least-16-characters
SESSION_SECRET=replace-with-a-random-session-secret-at-least-32-characters
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace-locally
LLM_PRIMARY_MODEL=your-primary-model
LLM_FALLBACK_MODEL=your-fallback-model
LLM_TIMEOUT=70
DISTILL_BASE_URL=https://api.ciyuan.fast/v1
DISTILL_API_KEY=replace-locally
DISTILL_MODEL=gpt-6-astra
DISTILL_REASONING_EFFORT=max
DISTILL_TIMEOUT=240
# Optional Langfuse tracing. Without LANGFUSE_BASE_URL the SDK sends to Langfuse Cloud.
# LANGFUSE_BASE_URL=https://langfuse.example.com
# LANGFUSE_PUBLIC_KEY=pk-lf-replace-locally
# LANGFUSE_SECRET_KEY=sk-lf-replace-locally
